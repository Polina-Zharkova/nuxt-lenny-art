 type: String,\r\n      default: \"\",\r\n    },\r\n    placeholder: {\r\n      type: String,\r\n      default: \"\",\r\n    },\r\n    rules: {\r\n      type: Object,\r\n      default: () => ({}),\r\n    },\r\n    submitCount: {\r\n      type: Number,\r\n      default: 0,\r\n    }\r\n  });\r\n\r\n  const { errorMessage, value } = useField(props.name, props.rules, {\r\n    initialValue: props.initialValue,\r\n  });\r\n\r\n</script>\r\n<style lang=\"less\">\r\n\r\n</style>","<template>\r\n  <form class=\"events-form\" @submit=\"onSubmit\">\r\n    <div class=\"events-form__list\">\r\n        <div class=\"events-form__group events-form__group--w50\">\r\n            <FieldRadio name=\"format\" initialValue=\"seminar\" :options=\"[\r\n                {\r\n                    label: 'Мастер-класс/семинар',\r\n                    value: 'seminar',\r\n                },\r\n                {\r\n                    label: 'Концерт/выступление',\r\n                    value: 'concert',\r\n                },\r\n                {\r\n                    label: 'Выставка/показ',\r\n                    value: 'show',\r\n                },\r\n                {\r\n                    label: 'Другое',\r\n                    value: 'other',\r\n                }\r\n            ]\"\r\n            :rules=\"{ required: true }\"\r\n            :submitCount=\"submitCount\"\r\n            label=\"Формат мероприятия\"\r\n            class=\"events-form__field\"\r\n            />\r\n        </div>\r\n\r\n         <div class=\"events-form__group events-form__group--w50\">\r\n            <FieldSelect\r\n          name=\"amount\"\r\n          :options=\"[\r\n            {\r\n              label: 'до 20 человек',\r\n              value: '20',\r\n            },\r\n            {\r\n              label: 'от 20 до 100 человек',\r\n              value: '100',\r\n            },\r\n            {\r\n              label: 'от 100 до 500 человек',\r\n              value: '500',\r\n            },\r\n            {\r\n              label: 'более 500 человек',\r\n              value: '1000',\r\n            },\r\n          ]\"\r\n          :rules=\"{ required: true }\"\r\n          searchable\r\n          :submitCount=\"submitCount\"\r\n          label=\"Планируемое количество посетителей:\"\r\n          placeholder=\"Выберите количество\"\r\n          class=\"events-form__field\"\r\n        />\r\n\r\n        <FieldDate\r\n          name=\"date\"\r\n          label=\"Дата проведения:\"\r\n          class=\"events-form__field\"\r\n          :rules=\"{ required: true }\"\r\n          :submitCount=\"submitCount\"\r\n        />\r\n         </div>\r\n    </div>\r\n\r\n    <div class=\"events-form__section>\">\r\n      <h6 class=\"events-form__section-title filed-title\">Контактные данные:</h6>\r\n\r\n      <div class=\"events-form__list\">\r\n        <FieldInput \r\n        name=\"first_name\" \r\n        label=\"Имя\" \r\n        placeholder=\"Имя\" \r\n        class=\"events-form__field events-form__field--w50\" \r\n        :rules=\"{\r\n          required: true\r\n        }\"\r\n        :submitCount=\"submitCount\"\r\n        />\r\n\r\n        <FieldInput \r\n        name=\"last_name\" \r\n        label=\"Фамилия\" \r\n        placeholder=\"Фамилия\" \r\n        class=\"events-form__field events-form__field--w50\" \r\n        :rules=\"{\r\n          required: true\r\n        }\"\r\n        :submitCount=\"submitCount\"\r\n        />\r\n\r\n        <FieldInput \r\n        name=\"phone\" \r\n        label=\"Телефон\" \r\n        placeholder=\"+7 (###) ###-##-##\"\r\n        mask=\"+7 (###) ###-##-##\"  \r\n        class=\"events-form__field events-form__field--w50\" \r\n        :rules=\"{\r\n          required: true,\r\n          phone: true\r\n        }\"\r\n        :submitCount=\"submitCount\"\r\n        />\r\n\r\n        <FieldInput \r\n        name=\"email\"\r\n        type=\"email\" \r\n        label=\"E-mail\" \r\n        placeholder=\"E-mail\" \r\n        class=\"events-form__field events-form__field--w50\" \r\n        :rules=\"{\r\n          required: true,\r\n          email: true\r\n        }\"\r\n        :submitCount=\"submitCount\"\r\n        />\r\n      </div>\r\n    </div>\r\n\r\n    <FieldText  \r\n    name=\"text\" \r\n    label=\"Есть пожелания? Напишите нам:\"\r\n    :submitCount=\"submitCount\" \r\n    class=\"events-form__field\"\r\n    />\r\n\r\n    <FieldCheck \r\n      name=\"agreement\"\r\n      :rules=\"{ \r\n        required: true, \r\n        }\"\r\n      :submitCount=\"submitCount\"\r\n      :label=\"`Я соглашаюсь с <a href='#' target='_blank'>пользовательским соглашением</a> и с <a href='#' target='_blank'>политикой</a> использования персональных данных`\"\r\n      smallLabel\r\n      class=\"events-form__field\"\r\n      />\r\n\r\n    <div class=\"events-form__btns\">\r\n      <button type=\"submit\" class=\"btn events-form__submit\">Отправить</button>\r\n\r\n      <button type=\"button\" class=\"events-form__close-btn\" @click=\"close\">\r\n        Закрыть\r\n      </button>\r\n    </div>\r\n  </form>\r\n</template>\r\n\r\n<script setup>\r\nimport { useForm } from \"vee-validate\";\r\n\r\nconst { submitCount, handleSubmit } = useForm();\r\n\r\n  const emits = defineEmits([\"close\"]);\r\n\r\n  const close = () => {\r\n    emits(\"close\");\r\n  };\r\n\r\n  const onSubmit = handleSubmit((submitValues) => {\r\n    console.log(submitValues);\r\n    alert(\"Отправлено\");\r\n\r\n    close();\r\n  });\r\n</script>\r\n\r\n<style lang=\"less\">\r\n  .events-form {\r\n    &__list {\r\n        display: flex;\r\n        flex-wrap: wrap;\r\n        justify-content: space-between;\r\n    }\r\n    &__field,\r\n    &__group {\r\n        width: 100%;\r\n        &--w50 {\r\n            width: calc(50% - 30px);\r\n            @media @bw1020 {\r\n                width: calc(50% - 15px);\r\n            }\r\n\r\n            @media @bw768 {\r\n                width: 100%;\r\n            }\r\n        }\r\n    }\r\n    &__field {\r\n        margin: 0 0 30px;\r\n    }\r\n    &__check {\r\n        margin-bottom: 10px;\r\n        &:last-child {\r\n            margin-bottom: 0;\r\n        }\r\n    }\r\n    &__section {\r\n        margin: 0 0 20px;\r\n    }\r\n    &__section-title {\r\n        margin: 0 0 10px;\r\n        font-size: 18px;\r\n    }\r\n    &__btns {\r\n        display: flex;\r\n        align-items: center;\r\n        margin-top: 10px;\r\n        @media @bw768 {\r\n            flex-direction: column;\r\n            align-items: center;\r\n        }\r\n    }\r\n    &__submit {\r\n        width: calc(50% - 30px);\r\n        @media @bw1020 {\r\n            width: calc(50% - 15px);\r\n        }\r\n        @media @bw768 {\r\n                width: 100%;\r\n            }\r\n    }\r\n    &__close-btn {\r\n        margin: 0 auto;\r\n        padding: 4px 0;\r\n        border: none;\r\n        background: transparent;\r\n        color: @black;\r\n        font-weight: 600;\r\n        font-size: 16px;\r\n        line-height: 22px;\r\n        text-decoration: underline;\r\n        transition: color 0.2s;\r\n        @media @bw768 {\r\n            margin: 30px auto 0;\r\n    } \r\n     &:active {\r\n     color: @red;   \r\n    }\r\n    &:hover {\r\n        @media (hover:hover) {\r\n            color: @red;\r\n        }\r\n    } \r\n    }\r\n  }\r\n</style>","<template>\r\n    <section class=\"app-offers\">\r\n        <h1 class=\"app-offers__title\">Я хочу:</h1>\r\n\r\n        <div class=\"app-offers__btns\">\r\n            <button type=\"button\" class=\"app-offers__btn btn btn--red\" @click=\"openPopup\">\r\n                Провести мероприятие\r\n            </button>\r\n\r\n            <button type=\"button\" class=\"app-offers__btn btn\">\r\n                Стать арендатором\r\n            </button>\r\n        </div>\r\n\r\n        <ModalWindow alive :name=\"'getOffer'\" :title=\"'Заполните форму<br />и мы подберем площадку'\">\r\n            <EventsForm @close=\"closePopup\" />\r\n        </ModalWindow>\r\n    </section>\r\n</template>\r\n\r\n<script setup>\r\nconst store = useStore();\r\nconst openPopup = () => {\r\nstore.openModal(\"getOffer\");\r\n};\r\n\r\nconst closePopup = () => {\r\nstore.closeModal(\"getOffer\");\r\n};\r\n</script>\r\n\r\n<style lang=\"less\">\r\n.app-offers {\r\n    .container;\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    text-align: center;\r\n    &__title {\r\n        .width_624;\r\n        margin: 0 auto 45px;\r\n        font-weight: 400;\r\n        font-family: @font2;\r\n        font-size: 22px;\r\n        line-height: 1.36;\r\n        letter-spacing: 0.02em;\r\n        text-transform: uppercase;\r\n        @media @bw1340 {\r\n            font-size: 16px;\r\n        }\r\n        @media @bw600 {\r\n            margin: 0 auto;\r\n        }\r\n        @media @bw500 {\r\n            font-size: 13px;\r\n        }\r\n    }\r\n&__btns {\r\n    .width_624;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    @media @bw600 {\r\n        flex-direction: column;\r\n        align-items:stretch;\r\n    }\r\n}\r\n&__btn {\r\n    @media @bw600 {\r\n        width: 100%;\r\n        margin-top: 25px;\r\n    }\r\n}\r\n}\r\n</style>"],"version":3}